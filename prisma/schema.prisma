generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  pending
  approved
  cancelled
}

enum ParentType {
  Role
  User
  Group
}

enum EmployeeStatus {
  ACTIVE
  RESIGNED
  REJOINED
  FIRE
}

model Customer {
  id          String     @id @default(uuid())
  name        String
  email       String?
  phone       String?
  address     String?
  gatePasses  GatePass[]
  createdAt   DateTime?
  updatedAt   DateTime?
  isDeleted   DateTime?
  createdById String?    @db.VarChar(36)
  updatedById String?    @db.VarChar(36)
  deletedById String?    @db.VarChar(36)
}

model Item {
  id          String         @id @default(uuid())
  name        String
  description String?
  quantity    Int?
  unitPrice   Float?
  gatePasses  GatePassItem[]
  createdAt   DateTime?
  updatedAt   DateTime?
  isDeleted   DateTime?
  createdById String?        @db.VarChar(36)
  updatedById String?        @db.VarChar(36)
  deletedById String?        @db.VarChar(36)
}

model GatePass {
  id            String         @id @default(uuid())
  customerId    String
  status        Status         @default(pending)
  notes         String?
  location      String
  vehicleNo     String
  storeIncharge String
  signature     String?
  createdAt     DateTime?
  updatedAt     DateTime?
  isDeleted     DateTime?
  issuedAt      DateTime?      @default(now())
  validUntil    DateTime?
  items         GatePassItem[]
  customer      Customer       @relation(fields: [customerId], references: [id])
  createdById   String?        @db.VarChar(36)
  updatedById   String?        @db.VarChar(36)
  deletedById   String?        @db.VarChar(36)
}

model GatePassItem {
  id         String    @id @default(uuid())
  gatePassId String
  itemId     String
  quantity   Int
  serialNos  String[]
  createdAt  DateTime?
  updatedAt  DateTime?
  isDeleted  DateTime?
  item       Item      @relation(fields: [itemId], references: [id])
  gatePass   GatePass  @relation(fields: [gatePassId], references: [id])
}

model User {
  id        String    @id @default(uuid()) @db.VarChar(36)
  username  String    @unique @db.VarChar(256)
  password  String    @db.VarChar(256)
  createdAt DateTime?
  updatedAt DateTime?
  isDeleted DateTime?

  userGroups      UserGroup[]
  blacklistTokens BlacklistToken[]
  loggedInUsers   LoggedInUsers[]
  userRoles       UserRole[]
  employee        Employee?        @relation(fields: [employeeId], references: [id])
  employeeId      String?          @unique
  activityLogs    ActivityLog[]
  salesAgent      SalesAgent?
  createdById     String?          @db.VarChar(36)
  updatedById     String?          @db.VarChar(36)
  deletedById     String?          @db.VarChar(36)
}

model Group {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @unique @db.VarChar(256)
  readAccess  Json?     @db.JsonB
  writeAccess Json?     @db.JsonB
  createdAt   DateTime?
  updatedAt   DateTime?
  isDeleted   DateTime?

  userGroups  UserGroup[]
  groupRoles  GroupRole[]
  createdById String?     @db.VarChar(36)
  updatedById String?     @db.VarChar(36)
  deletedById String?     @db.VarChar(36)
}

model UserGroup {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  groupId   String    @db.VarChar(36)
  active    Boolean
  createdAt DateTime?
  updatedAt DateTime?
  isDeleted DateTime?

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model Role {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @unique
  readAccess  Json?     @db.JsonB
  writeAccess Json?     @db.JsonB
  createdAt   DateTime?
  updatedAt   DateTime?
  isDeleted   DateTime?

  userRoles   UserRole[]
  groupRoles  GroupRole[]
  createdById String?     @db.VarChar(36)
  updatedById String?     @db.VarChar(36)
  deletedById String?     @db.VarChar(36)
}

model UserRole {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  roleId    String    @db.VarChar(36)
  active    Boolean
  createdAt DateTime?
  updatedAt DateTime?
  isDeleted DateTime?

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model GroupRole {
  id        String    @id @default(uuid()) @db.VarChar(36)
  groupId   String    @db.VarChar(36)
  roleId    String    @db.VarChar(36)
  active    Boolean
  createdAt DateTime?
  updatedAt DateTime?
  isDeleted DateTime?

  group Group @relation(fields: [groupId], references: [id])
  role  Role  @relation(fields: [roleId], references: [id])

  @@unique([groupId, roleId])
}

model AppFeature {
  name            String       @id @db.VarChar(256)
  parentFeatureId String?      @db.VarChar(256)
  label           String
  parentFeature   AppFeature?  @relation("ParentChild", fields: [parentFeatureId], references: [name])
  children        AppFeature[] @relation("ParentChild")
  createdAt       DateTime?
  updatedAt       DateTime?
  isDeleted       DateTime?
}

model FeaturePermission {
  id          String     @id @default(uuid()) @db.VarChar(36)
  parentType  ParentType
  parentId    String     @db.VarChar(36)
  permissions Json       @db.JsonB
  createdAt   DateTime?
  updatedAt   DateTime?
  isDeleted   DateTime?
  createdById String?    @db.VarChar(36)
  updatedById String?    @db.VarChar(36)
  deletedById String?    @db.VarChar(36)
}

model BlacklistToken {
  id         String    @id @default(uuid()) @db.VarChar(36)
  token      String    @unique
  rememberMe Boolean
  userId     String    @db.VarChar(36)
  createdAt  DateTime?
  user       User      @relation(fields: [userId], references: [id])
}

model LoggedInUsers {
  id         String    @id @default(uuid()) @db.VarChar(36)
  token      String    @unique
  userId     String    @db.VarChar(36)
  rememberMe Boolean
  createdAt  DateTime?
  user       User      @relation(fields: [userId], references: [id])
}

model Employee {
  id                 String         @id @default(uuid()) @db.VarChar(36)
  name               String
  surname            String
  address            String
  dob                DateTime
  cnic               String         @default("")
  joiningDate        DateTime
  bloodGroup         String
  contactNo          String
  emergencyContactNo String?
  faceDescriptor     Json?          @db.JsonB
  designation        String
  department         String
  martialStatus      String
  noOfChildrens      Int?
  filePaths          String[]       @default([])
  notes              String?
  status             EmployeeStatus @default(ACTIVE)
  resignationDate    DateTime?

  company         Company
  image           String?
  code            String    @unique
  createdAt       DateTime?
  updatedAt       DateTime?
  isDeleted       DateTime?
  createdBy       String?   @db.VarChar(36)
  updatedBy       String?   @db.VarChar(36)
  previousUpdates Json?     @db.JsonB

  user               User?
  attendances        Attendance[]
  leaveRequests      LeaveRequest[]
  attendanceRequests AttendanceRequest[]
  leaveAllocation    LeaveAllocation[]
  shiftAssignments   ShiftAssignment[]
  teamsLed           Team[]              @relation("TeamLead")
  teamMemberships    TeamMember[]        @relation("TeamMemberEmployee")
  taskAssignments    TaskAssignee[]      @relation("TaskAssignee")
  dailyReports       DailyReport[]       @relation("DailyReportEmployee")
  managedUnits       Unit[]              @relation("UnitAttendanceManager")
  unitEmployees      UnitEmployee[]
  visitorsReferred   Visitor[]           @relation("VisitorReferredTo")
  salesAgent         SalesAgent?
  createdById        String?             @db.VarChar(36)
  updatedById        String?             @db.VarChar(36)
  deletedById        String?             @db.VarChar(36)
}

enum Company {
  SOLARMAX
  POWERHIGHWAY
  OKASHASMART
}

model Attendance {
  id              String           @id @default(uuid()) @db.VarChar(36)
  employee        Employee         @relation(fields: [employeeId], references: [id])
  employeeId      String
  date            DateTime
  status          AttendanceStatus
  comment         String?
  checkIn         DateTime?
  checkOut        DateTime?
  location        String?
  createdAt       DateTime?
  updatedAt       DateTime?
  isDeleted       DateTime?
  createdBy       String?          @db.VarChar(36)
  updatedBy       String?          @db.VarChar(36)
  previousUpdates Json?            @db.JsonB
  createdById     String?          @db.VarChar(36)
  updatedById     String?          @db.VarChar(36)
  deletedById     String?          @db.VarChar(36)
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  HALF_DAY
  HOLIDAYS
}

model LeaveRequest {
  id                String           @id @default(uuid()) @db.VarChar(36)
  employee          Employee         @relation(fields: [employeeId], references: [id])
  employeeId        String
  leaveAllocation   LeaveAllocation? @relation(fields: [leaveAllocationId], references: [id])
  leaveAllocationId String?
  reason            String?
  startDate         DateTime
  endDate           DateTime
  status            LeaveStatus      @default(PENDING)
  leaveType         String?          @default("CASUAL") @db.VarChar(50)
  image             String?
  location          String?
  createdAt         DateTime?        @default(now())
  updatedAt         DateTime?        @updatedAt
  isDeleted         DateTime?
  createdById       String?          @db.VarChar(36)
  updatedById       String?          @db.VarChar(36)
  deletedById       String?          @db.VarChar(36)
}

model AttendanceRequest {
  id               String      @id @default(uuid()) @db.VarChar(36)
  employee         Employee    @relation(fields: [employeeId], references: [id])
  employeeId       String
  attendanceId     String?     @db.VarChar(36)
  reason           String?
  status           LeaveStatus @default(PENDING)
  image            String?
  location         String?
  // Proposed attendance changes
  proposedStatus   String?
  proposedCheckIn  DateTime?
  proposedCheckOut DateTime?
  proposedComment  String?
  proposedLocation String?
  proposedDate     DateTime?
  requestedBy      String?     @db.VarChar(36)
  approvedBy       String?     @db.VarChar(36)
  createdAt        DateTime?   @default(now())
  updatedAt        DateTime?   @updatedAt
  isDeleted        DateTime?
  createdById      String?     @db.VarChar(36)
  updatedById      String?     @db.VarChar(36)
  deletedById      String?     @db.VarChar(36)
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveConfiguration {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @unique
  description String?
  maxDays     Int
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  isDeleted   DateTime?

  employees   LeaveAllocation[]
  createdById String?           @db.VarChar(36)
  updatedById String?           @db.VarChar(36)
  deletedById String?           @db.VarChar(36)
}

model LeaveAllocation {
  id                  String              @id @default(uuid()) @db.VarChar(36)
  employee            Employee            @relation(fields: [employeeId], references: [id])
  employeeId          String
  leaveConfig         LeaveConfiguration? @relation(fields: [leaveConfigId], references: [id])
  leaveConfigId       String?
  assignedDays        Int
  usedDays            Int                 @default(0)
  remainingDays       Int                 @default(0)
  note                String?
  allocationStartDate DateTime
  allocationEndDate   DateTime?
  createdAt           DateTime?           @default(now())
  updatedAt           DateTime?           @updatedAt
  isDeleted           DateTime?

  leaveRequests LeaveRequest[]
  createdById   String?        @db.VarChar(36)
  updatedById   String?        @db.VarChar(36)
  deletedById   String?        @db.VarChar(36)
}

enum ScheduleParent {
  LEAVE
  ABSENT
  CHECK_OUT
}

enum ScheduleStatus {
  SUCCESS
  FAIL
  SKIP
}

model AttendanceScheduler {
  id          String         @id @default(uuid()) @db.VarChar(36)
  parent      ScheduleParent
  runTime     DateTime
  status      ScheduleStatus
  employeeIds String[]
  log         String?
  createdAt   DateTime?
  updatedAt   DateTime?
  isDeleted   DateTime?
}

model Shift {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @unique
  startTime   DateTime
  endTime     DateTime
  description String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  isDeleted   DateTime?

  assignments     ShiftAssignment[]
  timetables      ShiftTimetable[]
  timetableBlocks ShiftTimetableBlock[]
  createdById     String?               @db.VarChar(36)
  updatedById     String?               @db.VarChar(36)
  deletedById     String?               @db.VarChar(36)
}

model ShiftTimetable {
  id        String    @id @default(uuid()) @db.VarChar(36)
  shiftId   String    @db.VarChar(36)
  dayOfWeek Int
  startTime DateTime
  endTime   DateTime
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  isDeleted DateTime?

  shift Shift @relation(fields: [shiftId], references: [id])

  @@unique([shiftId, dayOfWeek])
}

enum ShiftTimetableBlockType {
  WORK
  BREAK
  CUSTOM
}

model ShiftTimetableBlock {
  id         String                  @id @default(uuid()) @db.VarChar(36)
  shiftId    String                  @db.VarChar(36)
  dayOfWeek  Int
  startTime  DateTime
  endTime    DateTime
  type       ShiftTimetableBlockType @default(WORK)
  customType String?
  label      String?
  createdAt  DateTime?               @default(now())
  updatedAt  DateTime?               @updatedAt
  isDeleted  DateTime?

  shift Shift @relation(fields: [shiftId], references: [id])

  @@index([shiftId, dayOfWeek])
}

model ShiftAssignment {
  id         String    @id @default(uuid()) @db.VarChar(36)
  employeeId String
  shiftId    String
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
  isDeleted  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift    @relation(fields: [shiftId], references: [id])

  createdById String? @db.VarChar(36)
  updatedById String? @db.VarChar(36)
  deletedById String? @db.VarChar(36)

  @@unique([employeeId, shiftId, startDate])
}

// ---------------- Work module (Teams, Tasks, Daily reports) ----------------
// Supersedes the old Todo stub (which had no code and no data): Task is the richer successor.

model Team {
  id          String       @id @default(uuid()) @db.VarChar(36)
  name        String
  description String?
  leadId      String?      @db.VarChar(36)
  lead        Employee?    @relation("TeamLead", fields: [leadId], references: [id])
  unitId      String?      @db.VarChar(36)
  unit        Unit?        @relation("TeamUnit", fields: [unitId], references: [id])
  company     Company      @default(OKASHASMART)
  // per-team configurable task statuses (first = initial, last = done)
  statuses    String[]     @default(["TODO", "IN_PROGRESS", "BLOCKED", "REVIEW", "DONE"])
  members     TeamMember[]
  tasks       Task[]
  createdAt   DateTime?    @default(now())
  updatedAt   DateTime?    @updatedAt
  isDeleted   DateTime?
  createdBy   String?      @db.VarChar(36)
  updatedBy   String?      @db.VarChar(36)
  createdById String?      @db.VarChar(36)
  updatedById String?      @db.VarChar(36)
  deletedById String?      @db.VarChar(36)

  @@index([leadId])
  @@index([unitId])
}

model TeamMember {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  teamId              String    @db.VarChar(36)
  team                Team      @relation(fields: [teamId], references: [id])
  employeeId          String    @db.VarChar(36)
  employee            Employee  @relation("TeamMemberEmployee", fields: [employeeId], references: [id])
  requiresDailyReport Boolean   @default(true) // only required members are "expected" to submit
  createdAt           DateTime? @default(now())
  isDeleted           DateTime?

  @@unique([teamId, employeeId])
  @@index([employeeId])
}

model Task {
  id             String              @id @default(uuid()) @db.VarChar(36)
  code           String?             @unique
  title          String
  description    String?
  teamId         String?             @db.VarChar(36)
  team           Team?               @relation(fields: [teamId], references: [id])
  status         String              @default("TODO") // validated against the team's status list
  priority       TaskPriority        @default(MEDIUM)
  dueDate        DateTime?
  startDate      DateTime?
  estimateHours  Float?
  labels         String[]            @default([])
  attachments    String[]            @default([])
  linkType       String? // LEAD | ORDER | CUSTOMER (loose link to a CRM record)
  linkId         String?             @db.VarChar(36)
  recurring      RecurringRule       @default(NONE)
  recurredFromId String?             @db.VarChar(36)
  completedAt    DateTime?
  createdById    String?             @db.VarChar(36) // User who created it
  company        Company             @default(OKASHASMART)
  assignees      TaskAssignee[]
  checklist      TaskChecklistItem[]
  comments       TaskComment[]
  watchers       TaskWatcher[]
  createdAt      DateTime?           @default(now())
  updatedAt      DateTime?           @updatedAt
  isDeleted      DateTime?
  createdBy      String?             @db.VarChar(36)
  updatedBy      String?             @db.VarChar(36)
  updatedById    String?             @db.VarChar(36)
  deletedById    String?             @db.VarChar(36)

  @@index([teamId])
  @@index([status])
  @@index([dueDate])
}

model TaskAssignee {
  id         String   @id @default(uuid()) @db.VarChar(36)
  taskId     String   @db.VarChar(36)
  task       Task     @relation(fields: [taskId], references: [id])
  employeeId String   @db.VarChar(36)
  employee   Employee @relation("TaskAssignee", fields: [employeeId], references: [id])

  @@unique([taskId, employeeId])
  @@index([employeeId])
}

model TaskChecklistItem {
  id        String    @id @default(uuid()) @db.VarChar(36)
  taskId    String    @db.VarChar(36)
  task      Task      @relation(fields: [taskId], references: [id])
  text      String
  done      Boolean   @default(false)
  sortOrder Int       @default(0)
  isDeleted DateTime?
}

model TaskComment {
  id          String    @id @default(uuid()) @db.VarChar(36)
  taskId      String    @db.VarChar(36)
  task        Task      @relation(fields: [taskId], references: [id])
  userId      String?   @db.VarChar(36)
  body        String
  createdAt   DateTime? @default(now())
  isDeleted   DateTime?
  createdById String?   @db.VarChar(36)

  @@index([taskId])
}

model TaskWatcher {
  id         String @id @default(uuid()) @db.VarChar(36)
  taskId     String @db.VarChar(36)
  task       Task   @relation(fields: [taskId], references: [id])
  employeeId String @db.VarChar(36)

  @@unique([taskId, employeeId])
}

model DailyReport {
  id           String               @id @default(uuid()) @db.VarChar(36)
  employeeId   String               @db.VarChar(36)
  employee     Employee             @relation("DailyReportEmployee", fields: [employeeId], references: [id])
  date         DateTime             @db.Date
  whatIDid     String?
  taskIds      String[]             @default([])
  hours        Float?
  blockers     String?
  planTomorrow String?
  attachments  String[]             @default([])
  late         Boolean              @default(false)
  comments     DailyReportComment[]
  createdAt    DateTime?            @default(now())
  updatedAt    DateTime?            @updatedAt
  isDeleted    DateTime?
  createdById  String?              @db.VarChar(36)
  updatedById  String?              @db.VarChar(36)
  deletedById  String?              @db.VarChar(36)

  @@unique([employeeId, date])
  @@index([date])
}

model DailyReportComment {
  id          String      @id @default(uuid()) @db.VarChar(36)
  reportId    String      @db.VarChar(36)
  report      DailyReport @relation(fields: [reportId], references: [id])
  userId      String?     @db.VarChar(36)
  body        String
  createdAt   DateTime?   @default(now())
  isDeleted   DateTime?
  createdById String?     @db.VarChar(36)

  @@index([reportId])
}

model Notification {
  id         String    @id @default(uuid()) @db.VarChar(36)
  userId     String    @db.VarChar(36) // recipient User id
  type       String // ASSIGNED | DUE_SOON | OVERDUE | COMMENT | REPORT_MISSING
  title      String
  body       String?
  entityType String? // Task | DailyReport
  entityId   String?   @db.VarChar(36)
  readAt     DateTime?
  createdAt  DateTime? @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurringRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Holiday {
  id              String    @id @default(uuid()) @db.VarChar(36)
  date            DateTime
  reason          String?
  description     String?
  isActive        Boolean   @default(true)
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  isDeleted       DateTime?
  createdBy       String?   @db.VarChar(36)
  updatedBy       String?   @db.VarChar(36)
  previousUpdates Json?     @db.JsonB
  createdById     String?   @db.VarChar(36)
  updatedById     String?   @db.VarChar(36)
  deletedById     String?   @db.VarChar(36)
}

// Run 11 Part 3: central audit trail. One row per audited write (and per explicit event:
// LOGIN/LOGOUT/LOGIN_FAILED/PERMISSION_CHANGE/EXPORT/IMPORT). Written by the Prisma audit
// extension inside the same transaction as the business write. `changes` holds only the changed
// fields as { field: { before, after } }, or { filter, count } for a bulk op. Secrets are masked.
model AuditLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  module     String?  // CRM | AMS | Work | RBAC | Frontdesk | App | Auth | System
  entity     String   // model name, e.g. "Lead"
  entityId   String?  @db.VarChar(36)
  action     String   // CREATE | UPDATE | DELETE | RESTORE | STATUS_CHANGE | ASSIGN | LOGIN | LOGOUT | LOGIN_FAILED | PERMISSION_CHANGE | EXPORT | IMPORT
  changes    Json?    @db.JsonB
  userId     String?  @db.VarChar(36)
  ip         String?
  userAgent  String?
  platform   String?
  requestId  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// Singleton system-wide configuration (single row, id = 'default')
model SystemConfig {
  id          String    @id @db.VarChar(36)
  config      Json?     @db.JsonB
  updatedAt   DateTime? @updatedAt
  updatedById String?   @db.VarChar(36)
}

enum UnitType {
  SERVICE_CENTER
  BRANCH
  OUTLET
  DEPARTMENT
  STORE
  WAREHOUSE
  OFFICE
  FACTORY
  OTHER
}

model Unit {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  name                String
  type                UnitType
  description         String?
  address             String?
  contactNo           String?
  email               String?
  attendanceManagerId String?   @db.VarChar(36)
  lateGraceMinutes    Int? // per-unit override; null = use global SystemConfig
  halfDayLateMinutes  Int? // per-unit override; null = use global SystemConfig
  createdAt           DateTime? @default(now())
  updatedAt           DateTime? @updatedAt
  isDeleted           DateTime?
  createdBy           String?   @db.VarChar(36)
  updatedBy           String?   @db.VarChar(36)
  previousUpdates     Json?     @db.JsonB

  attendanceManager Employee?      @relation("UnitAttendanceManager", fields: [attendanceManagerId], references: [id])
  employees         UnitEmployee[]
  teams             Team[]         @relation("TeamUnit")
  createdById       String?        @db.VarChar(36)
  updatedById       String?        @db.VarChar(36)
  deletedById       String?        @db.VarChar(36)
}

model UnitEmployee {
  id         String    @id @default(uuid()) @db.VarChar(36)
  unitId     String    @db.VarChar(36)
  employeeId String    @db.VarChar(36)
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
  isDeleted  DateTime?

  unit     Unit     @relation(fields: [unitId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([unitId, employeeId])
}

model ActivityLog {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String?   @db.VarChar(36)
  action      String // CREATE, UPDATE, DELETE, READ, APPROVE, REJECT, LOGIN, LOGOUT, etc.
  entityType  String // Employee, Attendance, AttendanceRequest, Unit, etc.
  entityId    String?   @db.VarChar(36)
  description String?
  metadata    Json?     @db.JsonB // Additional data about the action
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime? @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

enum VisitorOutcome {
  ENQUIRY
  PURCHASED
  REPLACED
  RECEIVED
  NO_ACTION
  OTHER
}

model Visitor {
  id                   String         @id @default(uuid()) @db.VarChar(36)
  name                 String
  phone                String?
  cnic                 String?
  vehicleNo            String?
  company              String?
  purpose              String?
  // Host the visitor was referred to: optional link to an Employee, with free-text fallback
  referredToText       String?
  referredToEmployeeId String?        @db.VarChar(36)
  referredToEmployee   Employee?      @relation("VisitorReferredTo", fields: [referredToEmployeeId], references: [id])
  visitDate            DateTime
  timeIn               DateTime?
  timeOut              DateTime?
  // Visit outcome / purchase tracking
  outcome              VisitorOutcome @default(ENQUIRY)
  purchased            Boolean        @default(false)
  purchaseAmount       Float?
  notes                String?
  createdAt            DateTime?      @default(now())
  updatedAt            DateTime?      @updatedAt
  isDeleted            DateTime?
  createdBy            String?        @db.VarChar(36)
  updatedBy            String?        @db.VarChar(36)
  previousUpdates      Json?          @db.JsonB

  createdById String? @db.VarChar(36)
  updatedById String? @db.VarChar(36)
  deletedById String? @db.VarChar(36)

  @@index([visitDate])
  @@index([referredToEmployeeId])
  @@index([outcome])
  @@index([isDeleted])
}

// ============================================================================
// Sales CRM (Okasha Smart) — see Docs/SalesCRM_Design.md
// ============================================================================

enum CrmProtocol {
  WIFI
  ZIGBEE
  BLUETOOTH
  RF
  WIRED
  OTHER
}

enum ProductStatus {
  ACTIVE
  DISCONTINUED
}

enum SalesChannel {
  WALK_IN
  PHONE
  WHATSAPP
  REFERRAL
  SOCIAL_MEDIA
  OFFLINE_MARKETING
  ONLINE_STORE
  OTHER
}

enum LeadStage {
  DRAFT
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION
  NEGOTIATION
  WON
  LOST
  ON_HOLD
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  RETURNED
  CANCELLED
}

enum ReturnStatus {
  REPORTED
  RECEIVED_BACK
  RESTOCKED
  DAMAGED
}

enum ActivityType {
  CALL
  WHATSAPP
  VISIT
  EMAIL
  QUOTATION_SENT
  NOTE
  OTHER
}

enum AgentScope {
  OWN
  TEAM
  ALL
}

enum PriceTier {
  RETAIL
  DEALER
  OUTLET
}

enum PaymentType {
  COD
  ADVANCE
  PARTIAL
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  legacyId    String?   @unique
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  isDeleted   DateTime?
  createdBy   String?
  updatedBy   String?
  createdById String?   @db.VarChar(36)
  updatedById String?   @db.VarChar(36)
  deletedById String?   @db.VarChar(36)
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  categoryId  String?
  isActive    Boolean   @default(true)
  products    Product[]
  legacyId    String?   @unique
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  isDeleted   DateTime?
  createdBy   String?
  updatedBy   String?
  createdById String?   @db.VarChar(36)
  updatedById String?   @db.VarChar(36)
  deletedById String?   @db.VarChar(36)
}

model Product {
  id          String           @id @default(uuid())
  sku         String           @unique
  name        String
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?           @relation(fields: [brandId], references: [id])
  protocol    CrmProtocol?
  description String?
  specs       Json?            @db.JsonB
  status      ProductStatus    @default(ACTIVE)
  stockItemId String? // loose link to gate-pass Item (deferred, see design §4.3)
  variants    ProductVariant[]
  images      ProductImage[]
  prices      PriceList[]
  legacyId    String?          @unique
  createdAt   DateTime?        @default(now())
  updatedAt   DateTime?        @updatedAt
  isDeleted   DateTime?
  createdBy   String?
  updatedBy   String?
  createdById String?          @db.VarChar(36)
  updatedById String?          @db.VarChar(36)
  deletedById String?          @db.VarChar(36)

  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id         String    @id @default(uuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  name       String
  attributes Json?     @db.JsonB
  skuSuffix  String?
  isActive   Boolean   @default(true)
  isDeleted  DateTime?

  @@unique([productId, name])
}

model ProductImage {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  url       String
  isPrimary Boolean   @default(false)
  sortOrder Int       @default(0)
  isDeleted DateTime?
}

model PriceList {
  id           String    @id @default(uuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  variantId    String?
  tier         PriceTier
  price        Int? // null until a real price is set (see pricePending)
  cost         Int? // cost-gated by crm.catalogue.cost.*; null = cost not yet known
  pricePending Boolean   @default(false) // true = placeholder, no usable price/cost yet
  validFrom    DateTime  @default(now())
  validTo      DateTime?
  isDeleted    DateTime?
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt
  createdBy    String?
  updatedBy    String?
  createdById  String?   @db.VarChar(36)
  updatedById  String?   @db.VarChar(36)
  deletedById  String?   @db.VarChar(36)

  @@index([productId, tier, validTo])
}

model Bundle {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  price       Int?
  isActive    Boolean      @default(true)
  items       BundleItem[]
  legacyId    String?      @unique
  createdAt   DateTime?    @default(now())
  updatedAt   DateTime?    @updatedAt
  isDeleted   DateTime?
  createdBy   String?
  updatedBy   String?
  createdById String?      @db.VarChar(36)
  updatedById String?      @db.VarChar(36)
  deletedById String?      @db.VarChar(36)
}

model BundleItem {
  id        String    @id @default(uuid())
  bundleId  String
  bundle    Bundle    @relation(fields: [bundleId], references: [id])
  productId String
  variantId String?
  quantity  Int       @default(1)
  isDeleted DateTime?
}

model SalesAgent {
  id            String       @id @default(uuid())
  agentCode     String       @unique
  employeeId    String       @unique
  employee      Employee     @relation(fields: [employeeId], references: [id])
  userId        String?      @unique
  user          User?        @relation(fields: [userId], references: [id])
  outlet        String?
  teamLeadId    String?
  teamLead      SalesAgent?  @relation("AgentTeam", fields: [teamLeadId], references: [id])
  members       SalesAgent[] @relation("AgentTeam")
  scope         AgentScope   @default(OWN)
  monthlyTarget Int?
  commissionPct Float?
  company       Company      @default(OKASHASMART)
  isActive      Boolean      @default(true)
  legacyId      String?      @unique
  createdAt     DateTime?    @default(now())
  updatedAt     DateTime?    @updatedAt
  isDeleted     DateTime?
  createdBy     String?
  updatedBy     String?
  createdById   String?      @db.VarChar(36)
  updatedById   String?      @db.VarChar(36)
  deletedById   String?      @db.VarChar(36)
}

model Lead {
  id              String        @id @default(uuid())
  leadNo          String?
  customerName    String
  phone           String?
  city            String?
  area            String? // short sub-locality within the city (e.g. "Johar Town" under Lahore)
  address         String? // full street address when the source gave one
  notes           String? // free-text that is clearly a note, not a location
  outlet          String?
  channel         SalesChannel?
  stage           LeadStage     @default(NEW)
  priority        LeadPriority  @default(MEDIUM)
  estimatedValue  Int?
  productId       String?
  requirement     String?
  agentId         String?
  dateReceived    DateTime      @default(now())
  lastContactAt   DateTime?
  nextFollowUpAt  DateTime?
  stageReason     String?
  lostReason      String?
  outcomeRaw      String? // raw Outcome column value for ambiguous-stage review
  visitorId       String?       @unique
  company         Company       @default(OKASHASMART)
  sourceFile      String?
  legacyId        String?
  createdAt       DateTime?     @default(now())
  updatedAt       DateTime?     @updatedAt
  isDeleted       DateTime?
  createdBy       String?
  updatedBy       String?
  phoneNormalized String?
  createdById     String?       @db.VarChar(36)
  updatedById     String?       @db.VarChar(36)
  deletedById     String?       @db.VarChar(36)

  @@unique([sourceFile, legacyId])
  @@index([agentId])
  @@index([stage])
  @@index([company])
  @@index([city])
  @@index([dateReceived])
  @@index([agentId, stage])
  @@index([phoneNormalized])
}

model LeadActivity {
  id             String       @id @default(uuid())
  leadId         String
  type           ActivityType
  outcome        String?
  occurredAt     DateTime     @default(now())
  nextFollowUpAt DateTime?
  agentId        String?
  notes          String?
  isDeleted      DateTime?
  createdAt      DateTime?    @default(now())
  createdBy      String?
  createdById    String?      @db.VarChar(36)

  @@index([leadId])
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNo     String
  version         Int             @default(1)
  isActive        Boolean         @default(true)
  parentId        String?
  leadId          String?
  customerName    String
  phone           String?
  status          QuotationStatus @default(DRAFT)
  tier            PriceTier       @default(RETAIL)
  items           QuotationItem[]
  subtotal        Int             @default(0)
  discount        Int             @default(0)
  total           Int             @default(0)
  validUntil      DateTime?
  statusReason    String?
  agentId         String?
  outlet          String?
  company         Company         @default(OKASHASMART)
  legacyId        String?         @unique
  createdAt       DateTime?       @default(now())
  updatedAt       DateTime?       @updatedAt
  isDeleted       DateTime?
  createdBy       String?
  updatedBy       String?
  phoneNormalized String?
  createdById     String?         @db.VarChar(36)
  updatedById     String?         @db.VarChar(36)
  deletedById     String?         @db.VarChar(36)

  @@unique([quotationNo, version])
  @@index([agentId])
  @@index([status])
  @@index([company])
  @@index([createdAt])
  @@index([phoneNormalized])
}

model QuotationItem {
  id           String    @id @default(uuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id])
  productId    String?
  variantId    String?
  description  String?
  quantity     Int       @default(1)
  unitPrice    Int
  unitCost     Int?
  lineDiscount Int       @default(0)
  lineTotal    Int
  isDeleted    DateTime?
}

model SalesOrder {
  id              String           @id @default(uuid())
  orderNo         String           @unique
  leadId          String?
  quotationId     String?
  customerName    String
  phone           String?
  city            String?
  outlet          String?
  address         String?
  status          SalesOrderStatus @default(DRAFT)
  items           SalesOrderItem[]
  subtotal        Int              @default(0)
  discount        Int              @default(0)
  total           Int              @default(0)
  channel         SalesChannel?
  externalOrderNo String? // e.g. Shopify order number (27125)
  courier         String? // PostEx / TCS / Leopards / self / outlet pickup
  trackingNo      String? // CN / tracking number
  paymentType     PaymentType? // COD / ADVANCE / PARTIAL
  amountReceived  Int? // amount received so far (PKR)
  area            String? // delivery sub-locality
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  reattemptCount  Int              @default(0)
  statusReason    String?
  agentId         String?
  company         Company          @default(OKASHASMART)
  sourceFile      String?
  legacyId        String?
  createdAt       DateTime?        @default(now())
  updatedAt       DateTime?        @updatedAt
  isDeleted       DateTime?
  createdBy       String?
  updatedBy       String?
  phoneNormalized String?
  createdById     String?          @db.VarChar(36)
  updatedById     String?          @db.VarChar(36)
  deletedById     String?          @db.VarChar(36)

  @@unique([sourceFile, legacyId])
  @@index([agentId])
  @@index([status])
  @@index([company])
  @@index([city])
  @@index([createdAt])
  @@index([reattemptCount])
  @@index([phoneNormalized])
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  orderId      String
  order        SalesOrder @relation(fields: [orderId], references: [id])
  productId    String?
  variantId    String?
  description  String?
  quantity     Int        @default(1)
  unitPrice    Int
  unitCost     Int?
  lineDiscount Int        @default(0)
  lineTotal    Int
  isDeleted    DateTime?
}

model SalesReturn {
  id              String       @id @default(uuid())
  returnNo        String       @unique
  orderId         String?
  customerName    String
  phone           String?
  city            String?
  status          ReturnStatus @default(REPORTED)
  reason          String
  courier         String?
  trackingNo      String?
  items           ReturnItem[]
  reportedAt      DateTime     @default(now())
  agentId         String?
  company         Company      @default(OKASHASMART)
  legacyId        String?      @unique
  createdAt       DateTime?    @default(now())
  updatedAt       DateTime?    @updatedAt
  isDeleted       DateTime?
  createdBy       String?
  updatedBy       String?
  phoneNormalized String?
  createdById     String?      @db.VarChar(36)
  updatedById     String?      @db.VarChar(36)
  deletedById     String?      @db.VarChar(36)

  @@index([status])
  @@index([city])
  @@index([agentId])
  @@index([reportedAt])
  @@index([phoneNormalized])
}

model ReturnItem {
  id          String      @id @default(uuid())
  returnId    String
  return      SalesReturn @relation(fields: [returnId], references: [id])
  productId   String?
  description String?
  quantity    Int         @default(1)
  isDeleted   DateTime?
}
